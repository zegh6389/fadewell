# FadeWell API — local environment template
# Copy to .env and fill in. Never commit a real .env.

NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:5173

# Use a separate migration-owner URL for migration/provisioning tasks.
DATABASE_URL=
# 32 random bytes, base64 encoded. Never use a sample key in a real environment.
DATA_ENCRYPTION_KEY=

OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Alternatively use hosted Supabase Auth. The anon key is sufficient; never use a service-role key in the API.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional username alias for the existing administrator's Supabase email. Set both together.
ADMIN_LOGIN_USERNAME=
ADMIN_LOGIN_EMAIL=

# Serve the compiled frontend from api/dist on the same origin when deploying the combined app.
SERVE_WEB=false

# Hosted Supabase requires its root CA, for example /app/deploy/supabase-ca.crt on Heroku.
# NODE_EXTRA_CA_CERTS=

# Enable only after questionnaire, consent, jurisdiction and deployment review.
INTAKE_ENABLED=false

# Operator CLI only; obtain the exact stable subject from your identity provider.
PROVISION_SUBJECT=

# Delivery remains disabled until approved accounts and verified destinations exist.
NOTIFICATIONS_ENABLED=false

# SMS uses Telnyx; the same key also enables Video Rooms (~$0.002/participant/min);
# without it bookings succeed but show media unavailable.
TELNYX_API_KEY=
TELNYX_FROM=
TELNYX_MESSAGING_PROFILE_ID=

# Approved SMTP provider (including SES SMTP). Implicit TLS on port 465 only.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
# Set SMTP_PASSWORD directly on Heroku with heroku config:set, never in chat or .env.
SMTP_PASSWORD=
EMAIL_FROM=
# Separate inbox patients can reach when they reply to a transactional message.
EMAIL_REPLY_TO=

# Only set in a lab environment with a self-signed certificate.
# FADEWELL_ALLOW_INSECURE_TLS=true
