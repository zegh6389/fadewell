{
  "name": "mmjgreen-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:postgres": "node --test tests/postgres/*.test.ts",
    "test:coverage": "node --experimental-test-coverage --test tests/*.test.ts",
    "migrate": "node --env-file-if-exists=.env src/migrate.ts",
    "provision": "node --env-file-if-exists=.env src/provision.ts",
    "worker": "node --env-file-if-exists=.env src/worker.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "argon2": "^0.45.1",
    "fastify": "^5.12.3",
    "nodemailer": "^10.0.3",
    "otplib": "^13.5.0",
    "pg": "^8.23.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.20.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "argon2@0.45.1": true
  }
}
